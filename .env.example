# ---------- Admin login ----------
# The admin account is created (or updated) from these when the server starts. Change both before you go online.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Public site origin used in email links. Set this to your production domain on Vercel.
# SITE_URL=https://your-domain.com

# ---------- Supabase database ----------
# Supabase dashboard > Project Settings > Database > Connection string > "Transaction pooler" (port 6543).
# Replace [YOUR-PASSWORD] with your database password. Use this on Vercel.
DATABASE_URL=postgresql://postgres.YOUR-PROJECT-REF:[YOUR-PASSWORD]@aws-0-REGION.pooler.supabase.com:6543/postgres
# Optional: Supabase's CA certificate (Project Settings > Database > SSL), pasted with \n for new lines, to verify the server.
# SUPABASE_DB_CA=

# ---------- Supabase Storage (photos, 360 photos and videos) ----------
# Project Settings > API: Project URL, and the service_role key (secret, server only, never put it in the app).
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
# Optional. The public bucket is created for you. Default: kole-media
# SUPABASE_BUCKET=kole-media
# Optional. Largest video in MB. Supabase free plan allows 50. Paid plans can raise it (and Storage > Settings).
# KOLE_MAX_VIDEO_MB=50

# ---------- Chat ----------
# Shown in the automatic reply when nobody on the team is online.
# KOLE_HOURS="9am to 6pm, Lagos time"
# Optional OpenAI assistant. When enabled, client chat text and relevant listing details
# are sent to OpenAI. Without a key, the built-in listing FAQ answers known questions.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini

# ---------- Email (SMTP) ----------
# Used for the Contact form: you get each message by email and the sender gets a receipt.
# Gmail: smtp.gmail.com, port 465, SMTP_SECURE=true, and an App Password. Other hosts: use the details they give you.
SMTP_HOST=smtp.example.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=hello@yourdomain.com
SMTP_PASS=
SMTP_FROM="Kolé <hello@yourdomain.com>"
# Where contact-form messages go. Defaults to ADMIN_EMAIL.
CONTACT_TO=hello@yourdomain.com

# ---------- Contact page details (shown on /contact) ----------
CONTACT_EMAIL=
CONTACT_PHONE=
CONTACT_WHATSAPP=
CONTACT_ADDRESS=
CONTACT_HOURS="Monday to Friday, 9am to 6pm (Lagos time)"

# ---------- Local only ----------
# Where the database file and uploaded files are kept when no DATABASE_URL is set. Defaults to ./data
# KOLE_DATA_DIR=./data
